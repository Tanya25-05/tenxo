# ─── Tenxo Production Configuration ────────────────────────────────────────
# Copy the relevant vars to your Render Dashboard for each service.

# === Backend (Go Matchmaker) — set on Render Web Service ===

API_ADDR=:8080
PUBLIC_API_URL=https://tenxo-api.onrender.com
NATS_URL=nats://nats:4222
REDIS_ADDR=redis://red-xxxxx:6379          # From Render Redis dashboard
REDIS_PASSWORD=
NATS_STREAM=JOB_STREAM
UPLOADS_DIR=uploads

# Supabase Auth — from https://supabase.com → Project Settings → API
SUPABASE_JWKS_URL=https://cvuxfobevbarzkjfswhr.supabase.co/auth/v1/.well-known/jwks.json

# Cloudflare R2 storage — from https://cloudflare.com → R2 → Bucket
R2_ACCOUNT_ID=54b4917e66df528493644555924ea076
R2_ACCESS_KEY_ID=f79394b45466c3a759c829ad55608db3
R2_SECRET_ACCESS_KEY=1b0615a73bbe5332d8134637247445952c55e8c92478053ddeac8baf4861f8d1
R2_BUCKET=gpu-grid-storage
R2_ENDPOINT=https://54b4917e66df528493644555924ea076.r2.cloudflarestorage.com/gpu-grid-storage

# === Razorpay — from https://dashboard.razorpay.com → API Keys ===
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx        # Generate in Razorpay → Settings → Webhooks
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# === Frontend (Next.js Static Site) — set on Render Static Site ===
