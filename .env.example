# ─── Tenxo Deployment Configuration ────────────────────────────────────────
# Copy this to .env and fill in your values.

# === Backend (Go Matchmaker) ===

# Server
API_ADDR=:8080
PUBLIC_API_URL=http://localhost:8080

# NATS (use nats:// for local, nats://<host>:4222 for remote)
NATS_URL=nats://localhost:4222

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# NATS JetStream stream name
NATS_STREAM=JOB_STREAM

# Supabase JWT Auth (optional - set to empty to disable JWT)
# Create a Supabase project at https://supabase.com, then get:
SUPABASE_JWKS_URL=https://<your-project>.supabase.co/.well-known/jwks.json

# Cloudflare R2 / S3-compatible storage (optional - uses local disk if empty)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Local storage fallback directory
UPLOADS_DIR=uploads

# === Stripe (Payment Processing) ===
# Create account at https://stripe.com, get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# === Frontend (Next.js) ===
# These are used by Vercel / Next.js build
NEXT_PUBLIC_API_URL=https://<your-backend>.onrender.com
NEXT_PUBLIC_WS_URL=wss://<your-backend>.onrender.com
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>
