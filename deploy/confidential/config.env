# config.env
# Tenxo Confidential GPU Compute — Node Configuration
#
# Source this file before running trusted-orchestration.sh:
#   sudo ./trusted-orchestration.sh --config ./config.env
#
# All secrets are read from environment variables or vault at runtime,
# never committed to version control.

# ─── Registry Authentication ─────────────────────────────────────────────────
REGISTRY_SERVER="ghcr.io"
REGISTRY_USERNAME="tenxo-bot"
# Personal Access Token with `read:packages` scope (GHCR)
# Generate at: https://github.com/settings/tokens
# In production, inject via: export REGISTRY_TOKEN=$(vault read -field=token ...)
REGISTRY_TOKEN=""

# Container image
IMAGE_TAG="ghcr.io/tenxo/edge-agent:latest"

# ─── Platform Key Management Service ─────────────────────────────────────────
# The KMS provides ephemeral AES-256-XTS keys for LUKS storage encryption.
# The key is delivered over TLS, used once, and never persisted to disk.
KMS_ENDPOINT="https://kms.tenxo.internal/v1/keys"
# Short-lived bearer token issued by the platform for this node+session.
# Must be rotated every N hours or on each job cycle.
KMS_TOKEN=""

# ─── Node Identity ───────────────────────────────────────────────────────────
NODE_ID="tenxo-node-$(hostname)"
OWNER=""
MATCHMAKER_URL="wss://matchmaker.tenxo.internal"

# ─── Hardware Configuration ──────────────────────────────────────────────────
# Leave empty for auto-detection (first NVMe device)
TARGET_DEVICE=""
STORAGE_SIZE_GB="64"

# GPU UUID(s) to target (comma-separated). Empty = all GPUs.
GPU_UUID=""

# ─── Confidential Computing Mode ─────────────────────────────────────────────
# These are read by the edge agent and runtime to enable TEE features.
SEV_SNP_ENABLED=1     # AMD SEV-SNP
SGX_ENABLED=0         # Intel SGX (set to 1 if no AMD)
TDX_ENABLED=0         # Intel TDX (set to 1 if using TDX)

# ─── Logging ─────────────────────────────────────────────────────────────────
LOGLEVEL="info"
LOGDIR="/var/log/tenxo"
